# Password Vault — Environment Variable Reference
# Copy to .env and fill in values, or export these in your shell/CI.

# ─── Required ────────────────────────────────────────────────────────────────

# 32-byte master key, base64url-encoded (no padding).
# Generate with: vault-cli init
# NEVER commit this value. Rotate by re-encrypting all secrets.
VAULT_MASTER_KEY=<generated-by-vault-cli-init>

# ─── Optional (shown with defaults) ─────────────────────────────────────────

# Path to the SQLite database file.
# Default: ./vault.db
# VAULT_DB_PATH=./vault.db

# TCP port the API server listens on.
# Default: 8080
# VAULT_PORT=8080

# Maximum API requests per second per client IP (token bucket).
# Default: 5
# VAULT_RATE_LIMIT=5
